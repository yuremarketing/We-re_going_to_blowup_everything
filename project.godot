; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited
; using the UI and not the code.

config_version=5

[application]

config/name="We're Going to Blow Up Everything"
config/description="Jogo de ação/sobrevivência contra multidão (horde/lane survival). Ver docs/epicas/EPICA-001-jogo-horde-survival.md."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icons/android/main_192x192.png"
boot_splash/bg_color=Color(0.043, 0.047, 0.043, 1)
boot_splash/image="res://assets/icons/android/boot_splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=5
window/energy_saving/keep_screen_on=true
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[autoload]

AudioManager="*res://scripts/audio_manager.gd"
GameState="*res://scripts/game_state.gd"
